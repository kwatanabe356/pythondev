   "source": [
    "import prognum\n",
    "\n",
    "# 何番目のフィボナッチ数を求めるか入力\n",
    "n = int(input(\"何番目のフィボナッチ数を求めますか？: \"))\n",
    "\n",
    "# 関数の実行\n",
    "result = prognum.fibonacci(n)\n",
    "\n",
    "# 結果の出力\n",
    "print(f\"{n}番目のフィボナッチ数は {result} です\")\n"
   ]
  }
